    "db:reset": "tsx lib/db/reset.ts && pnpm db:migrate && pnpm db:seed",
    "db:demo": "tsx lib/db/seed-demo.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-table": "^9.3.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "docx": "^9.12.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.1.7",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
