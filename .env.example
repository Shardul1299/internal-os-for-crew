# Postgres connection string (Supabase or Neon; use the pooled string on serverless)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/snoball

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Magic-link email (SMTP). Without it, magic links are printed to the server log
# and shown on the sign-in page in development.
EMAIL_SERVER=
EMAIL_FROM="Snoball OS <os@crew.example>"

# Development only: shows "Sign in as role" buttons on the sign-in page.
DEV_LOGIN=1

# Creator Studio AI (BRIEF §19.15). Org-level key can also be set in Settings by the Owner.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=

# Inbox forwarding (BRIEF §6). Shared secret for the inbound-email webhook.
INBOUND_EMAIL_SECRET=

# Google Calendar / Gmail (BRIEF §11). Optional; features stay manual without them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# First deploy: real sign-in addresses for the Owner and Crew lead (replace the seeded placeholders).
SEED_OWNER_EMAIL=
SEED_CREW_LEAD_EMAIL=
